<%- include('../particals/header') %>
<%- include('../particals/navbar') %>

<div class="chat-container glass">
    <div class="chat-header border-bottom">
        <h2>Global Chat</h2>
        <div style="display: flex; gap: 10px; align-items: center;">
            <button id="start-video-btn" class="video-call-btn" title="Start Video Call">
                <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M23 7l-7 5 7 5V7z"></path><rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect></svg>
                Call
            </button>
            <form action="/messages/clear-all?_method=DELETE" method="POST" onsubmit="return confirm('Are you sure you want to delete ALL messages forever?');">
                <button type="submit" class="clear-all-btn">Clear All</button>
            </form>
        </div>
    </div>
    
    <div id="chat-window">
        <% messages.forEach(msg => { %>
            <div id="msg-<%= msg._id %>" class="message <%= (msg.sender && msg.sender._id.equals(currentUser._id)) ? 'sent' : 'received' %>">
                <div class="sender">@<%= msg.sender ? msg.sender.username : 'Deleted User' %></div>
                <div class="text"><%= msg.text %></div>
                <div class="msg-footer">
                    <div class="time"><%= msg.createdAt.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %></div>
                    <% if (msg.sender && msg.sender._id.equals(currentUser._id)) { %>
                        <form action="/messages/<%= msg._id %>?_method=DELETE" method="POST" class="delete-form">
                            <button type="submit" class="delete-msg-btn">
                                <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                            </button>
                        </form>
                    <% } %>
                </div>
            </div>
        <% }) %>
    </div>
    
    <div class="chat-input-area border-top">
        <input type="text" id="chat-input" placeholder="Type a message..." autocomplete="off">
        <button class="send-btn" id="send-btn">
            <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" class="css-i6dz6"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
        </button>
    </div>
</div>

<script>
    const currentUser = {
        id: "<%= currentUser._id %>",
        username: "<%= currentUser.username %>"
    };
</script>
<!-- Incoming Call Floating Card -->
<div id="incoming-call-card" class="glass incoming-call-popup" style="display: none;">
    <div class="incoming-info">
        <div class="caller-avatar">📞</div>
        <div>
            <div style="font-weight: 700; font-size: 1.1rem; color: var(--text);">Incoming Video Call</div>
            <div id="caller-name" style="color: var(--primary); font-weight: 600; font-size: 0.9rem;">@Username</div>
        </div>
    </div>
    <div class="incoming-actions">
        <button id="accept-call-btn" class="call-action-btn accept">
            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            Accept
        </button>
        <button id="decline-call-btn" class="call-action-btn decline">
            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            Decline
        </button>
    </div>
</div>

<!-- Full Screen Glassmorphic Video Call Modal -->
<div id="video-call-modal" class="glass-modal" style="display: none;">
    <div class="video-container glass">
        <!-- Remote Video (main large screen) -->
        <video id="remote-video" autoplay playsinline></video>
        
        <!-- Local Video (small Pip view) -->
        <div class="local-video-wrapper glass">
            <video id="local-video" autoplay playsinline muted></video>
        </div>

        <!-- Floating Controls Panel -->
        <div class="call-controls-panel glass">
            <button id="toggle-mic-btn" class="control-btn active" title="Toggle Microphone">
                <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path><path d="M19 10v1a7 7 0 0 1-14 0v-1"></path><line x1="12" y1="19" x2="12" y2="23"></line><line x1="8" y1="23" x2="16" y2="23"></line></svg>
            </button>
            <button id="toggle-video-btn" class="control-btn active" title="Toggle Webcam">
                <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M23 7l-7 5 7 5V7z"></path><rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect></svg>
            </button>
            <button id="hangup-btn" class="control-btn hangup" title="End Call">
                <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M10.68 22.31A21.5 21.5 0 0 0 22.84 10A2.81 2.81 0 0 0 20 7.16h-3.25a1 1 0 0 0-1 .73l-1.07 3.22a1 1 0 0 0 .28 1l2 2a16 16 0 0 1-6 6l-2-2a1 1 0 0 0-1-.28l-3.22 1.07a1 1 0 0 0-.73 1V20a2.81 2.81 0 0 0 2.84 2.84z"></path></svg>
            </button>
        </div>
    </div>
</div>

<script src="/js/socket.js"></script>
<script src="/js/video.js"></script>

<%- include('../particals/footer') %>